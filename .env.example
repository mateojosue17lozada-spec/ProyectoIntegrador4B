# Configuración de Servidor Backend
PORT=3000
NODE_ENV=production
JWT_SECRET=super_secret_jwt_key_cambiar_en_produccion
CORS_ORIGIN=*

# Conexión a Base de Datos Supabase PostgreSQL (Transaction Pooler o Direct Connection)
# Ejemplo Supabase: postgresql://postgres.[project-ref]:[password]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://usuario:password@host_supabase:5432/nombre_db?sslmode=require

# Configuración del Frontend Web para Docker
VITE_API_URL=/api
